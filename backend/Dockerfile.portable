# syntax=docker/dockerfile:1
FROM rust:1.90-slim-bookworm@sha256:64232e656c058f4468e8d024e990acff04f0fd5a5c0a88a574dc37773d7325c9 AS build
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca rustup target add x86_64-unknown-linux-musl
WORKDIR /app
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src ./src
COPY backend/migrations ./migrations
RUN --mount=type=secret,id=proxy_ca CARGO_HTTP_CAINFO=/run/secrets/proxy_ca cargo build --release --locked --target x86_64-unknown-linux-musl
FROM scratch
COPY --from=build /app/target/x86_64-unknown-linux-musl/release/etp-carnet-server /server
COPY dist /dist
COPY LICENSE COPYING /licenses/
