;;; API du POC : le serveur valide les enveloppes, jamais les données métier.
(require :asdf)
(require :sb-posix)
(asdf:load-system :hunchentoot)
(asdf:load-system :postmodern)
(asdf:load-system :yason)
(asdf:load-system :ironclad)
(asdf:load-system :babel)

(defpackage :carnet (:use :cl))
(in-package :carnet)

(defun env (name default) (or (uiop:getenv name) default))
(defparameter *origin* (env "CARNET_PUBLIC_URL" "http://localhost:3000"))
(defparameter *secure-cookie* (or (uiop:string-prefix-p "https://" *origin*) (string= (env "CARNET_SECURE_COOKIE" "false") "true")))
(defparameter *db* (list (env "CARNET_DB_NAME" "carnet")
                        (env "CARNET_DB_USER" "carnet")
                        (env "CARNET_DB_PASSWORD" "local-development-only")
                        (env "CARNET_DB_HOST" "database")))
(defparameter *dist* (merge-pathnames "dist/" (uiop:getcwd)))
(defparameter *rate* (make-hash-table :test 'equal))
(defparameter *rate-lock* (bt:make-lock "limites"))
(defparameter *auth-limit* (parse-integer (env "CARNET_AUTH_RATE" "60")))
(defparameter *max-body* 4000000)
(defparameter *quota* 64000000)
(defparameter *ledger* (env "CARNET_DELETION_LEDGER" "/var/lib/carnet/deletions.log"))
(defparameter *ledger-lock* (bt:make-lock "journal-suppressions"))
(defparameter *headers*
  '(("Cache-Control" . "no-store")
    ("Referrer-Policy" . "no-referrer")
    ("X-Content-Type-Options" . "nosniff")
    ("Permissions-Policy" . "camera=(), microphone=(), geolocation=()")
    ("Content-Security-Policy" . "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'")))

(defun obj (&rest pairs)
  (let ((table (make-hash-table :test 'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key table) value))
    table))
(defun json (value) (with-output-to-string (stream) (yason:encode value stream)))
(defun field (value key) (when (hash-table-p value) (gethash key value)))
(defun response (code value)
  (setf (hunchentoot:return-code*) code
        (hunchentoot:content-type*) "application/json; charset=utf-8")
  (json value))
(defun reject (code text) (throw 'reply (response code (obj "error" text))))
(defun query (sql &rest args)
  (if args
      (progn
        (cl-postgres:prepare-query postmodern:*database* "" sql args)
        (cl-postgres:exec-prepared postmodern:*database* "" args 'cl-postgres:list-row-reader))
      (cl-postgres:exec-query postmodern:*database* sql 'cl-postgres:list-row-reader)))
(defun one (sql &rest args) (first (apply #'query sql args)))
(defmacro with-db (&body body)
  `(postmodern:with-connection (append *db* (list :pooled-p t)) ,@body))

(defun random-hex (size)
  (ironclad:byte-array-to-hex-string (ironclad:random-data size)))
(defun digest (text)
  (ironclad:byte-array-to-hex-string
   (ironclad:digest-sequence :sha256 (babel:string-to-octets text :encoding :utf-8))))
(defun uuid ()
  (let ((hex (random-hex 16)))
    (format nil "~a-~a-4~a-8~a-~a" (subseq hex 0 8) (subseq hex 8 12)
            (subseq hex 13 16) (subseq hex 17 20) (subseq hex 20 32))))
(defun uuid-p (text)
  (and (stringp text) (cl-ppcre:scan "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" text)))
(defun record-deletion (account)
  ;; Journal indépendant des backups PostgreSQL : fsync AVANT suppression SQL.
  (unless (uuid-p account) (error "Identifiant technique invalide"))
  (bt:with-lock-held (*ledger-lock*)
    (with-open-file (stream *ledger* :direction :output :if-exists :append :if-does-not-exist :error)
      (write-line account stream)
      (finish-output stream)
      (sb-posix:fsync (sb-sys:fd-stream-fd stream)))))
(defun replay-deletions ()
  (unless (probe-file *ledger*)
    ;; Initialisation autorisée seulement pour une base entièrement neuve.
    (unless (zerop (first (one "SELECT count(*) FROM comptes")))
      (error "Journal des suppressions manquant ; restauration refusée"))
    (with-open-file (stream *ledger* :direction :output :if-exists :error :if-does-not-exist :create)
      (finish-output stream))
    (sb-posix:chmod *ledger* #o600))
  (with-open-file (stream *ledger*)
    (loop for account = (read-line stream nil nil) while account do
      (unless (uuid-p account) (error "Journal des suppressions invalide"))
      (query "INSERT INTO suppressions(compte) VALUES($1::uuid) ON CONFLICT DO NOTHING" account)))
  (query "DELETE FROM comptes WHERE id IN (SELECT compte FROM suppressions)"))
(defun check-quota (account incoming &optional (replaced 0))
  (let ((used (first (one "SELECT coalesce((SELECT sum(octet_length(payload::text)) FROM coffres WHERE compte=$1::uuid),0)+coalesce((SELECT sum(octet_length(payload::text)) FROM objets WHERE compte=$1::uuid),0)+coalesce((SELECT sum(octet_length(payload::text)+octet_length(images::text)) FROM archives WHERE compte=$1::uuid),0)" account))))
    (when (> (+ (- used replaced) incoming) *quota*)
      (reject 413 "Quota de 64 Mo atteint. Exportez puis supprimez des pièces ou anciens coffres."))))
(defun equal-secret (left right)
  (and (stringp left) (stringp right)
       (let* ((a (babel:string-to-octets left))
              (b (babel:string-to-octets right)))
         (ironclad:constant-time-equal a b))))

;;; scrypt N=2^15, r=8, p=3 : paramètres OWASP pour ~32 Mio. Format versionné.
(defun password-key (password salt)
  (ironclad:derive-key (ironclad:make-kdf :scrypt-kdf :N 32768 :r 8 :p 3)
                       (babel:string-to-octets password :encoding :utf-8)
                       (ironclad:hex-string-to-byte-array salt) 1 32))
(defun hash-password (password)
  (let ((salt (random-hex 16)))
    (format nil "scrypt-v1$~a$~a" salt (ironclad:byte-array-to-hex-string (password-key password salt)))))
(defun verify-password (password stored)
  (let ((parts (uiop:split-string stored :separator "$")))
    (and (= (length parts) 3) (string= (first parts) "scrypt-v1")
         (equal-secret (third parts) (ironclad:byte-array-to-hex-string (password-key password (second parts)))))))

(defun throttle (category &optional identity)
  ;; Métadonnées éphémères, 15 min ; ni identifiant ni corps dans les journaux.
  (let* ((now (get-universal-time))
         (key (list category (digest (or identity (hunchentoot:remote-addr*))))))
    (bt:with-lock-held (*rate-lock*)
      (when (> (hash-table-count *rate*) 10000)
        (maphash (lambda (k v) (when (> (- now (car v)) 900) (remhash k *rate*))) *rate*))
      (let* ((record (gethash key *rate*))
             (count (if (and record (< (- now (car record)) 900)) (1+ (cdr record)) 1))
             (start (if (and record (< (- now (car record)) 900)) (car record) now))
             (limit (if identity 30 *auth-limit*)))
        (setf (gethash key *rate*) (cons start count))
        (when (> count limit)
          (setf (hunchentoot:header-out "Retry-After") "900")
          (reject 429 "Trop de tentatives. Réessayez plus tard."))))))

(defun read-body ()
  (unless (search "application/json" (or (hunchentoot:header-in* "Content-Type") ""))
    (reject 415 "Format JSON requis."))
  (let* ((length-header (hunchentoot:header-in* "Content-Length"))
         (length (and length-header (parse-integer length-header :junk-allowed t))))
    (unless (and length (<= 2 length *max-body*)) (reject 413 "Requête trop grande ou longueur absente."))
    (let ((text (hunchentoot:raw-post-data :force-text t)))
      (unless (and (stringp text) (<= (length text) *max-body*)) (reject 413 "Requête trop grande."))
      (handler-case (yason:parse text)
        (error () (reject 400 "JSON invalide."))))))
(defun check-origin ()
  ;; Origin obligatoire pour toutes les mutations, y compris l'authentification.
  (unless (equal (hunchentoot:header-in* "Origin") *origin*)
    (reject 403 "Origine de la requête non autorisée.")))
(defun validate-password (password)
  (unless (and (stringp password) (<= 12 (length password) 1024))
    (reject 400 "Le mot de passe doit contenir entre 12 et 1 024 caractères.")))
(defun validate-pseudo (pseudo)
  (unless (and (stringp pseudo) (cl-ppcre:scan "^[a-zA-Z0-9_-]{3,40}$" pseudo))
    (reject 400 "Identifiant : 3 à 40 lettres, chiffres, tirets ou underscores.")))
(defun base64-p (value &optional (maximum 3000000))
  (and (stringp value) (<= 16 (length value) maximum)
       (= 0 (mod (length value) 4)) (cl-ppcre:scan "^[A-Za-z0-9+/]+={0,2}$" value)))
(defun keys-exact (value names)
  (and (hash-table-p value) (= (hash-table-count value) (length names))
       (every (lambda (name) (nth-value 1 (gethash name value))) names)))
(defun validate-envelope (value vault object &optional wrapped)
  (unless
      (and (keys-exact value (if wrapped '("v" "vault" "object" "iv" "ct" "salt" "rounds") '("v" "vault" "object" "iv" "ct")))
           (eql (field value "v") 1) (equal (field value "vault") vault)
           (equal (field value "object") object)
           (base64-p (field value "iv") 16) (= (length (field value "iv")) 16)
           (base64-p (field value "ct"))
           (or (not wrapped) (and (eql (field value "rounds") 600000) (base64-p (field value "salt") 24)
                                  (= (length (field value "salt")) 24))))
    (reject 400 "Enveloppe chiffrée invalide.")))
(defun validate-payload (payload)
  (let* ((ring (field payload "keyring")) (vault (field ring "vault")))
    (unless (and (keys-exact payload '("keyring" "envelope"))
                 (keys-exact ring '("v" "vault" "phrase" "recovery"))
                 (eql (field ring "v") 1) (uuid-p vault))
      (reject 400 "Format de coffre invalide."))
    (validate-envelope (field payload "envelope") vault "journal")
    (validate-envelope (field ring "phrase") vault "phrase" t)
    (validate-envelope (field ring "recovery") vault "recovery")
    payload))

(defun session-row ()
  (let ((token (hunchentoot:cookie-in "carnet-session")))
    (when (and token (= (length token) 64))
      (one "SELECT compte::text, csrf FROM sessions WHERE token_hash=$1 AND expires_at>now() AND last_seen>now()-interval '2 hours'" (digest token)))))
(defun authenticated ()
  (let ((session (session-row)))
    (unless session (reject 401 "Connectez-vous pour accéder à votre compte."))
    (query "UPDATE sessions SET last_seen=now() WHERE token_hash=$1" (digest (hunchentoot:cookie-in "carnet-session")))
    (query "UPDATE comptes SET last_seen=now() WHERE id=$1::uuid" (first session))
    session))
(defun csrf (session)
  (unless (equal-secret (second session) (hunchentoot:header-in* "X-Carnet-CSRF"))
    (reject 403 "La protection de session a refusé cette requête.")))
(defun set-session-cookie (value &optional expire)
  ;; SameSite est ajouté explicitement pour compatibilité Hunchentoot Debian.
  (setf (hunchentoot:header-out "Set-Cookie")
        (format nil "carnet-session=~a; Path=/; HttpOnly; SameSite=Strict~a; Max-Age=~d"
                value (if *secure-cookie* "; Secure" "") (if expire 0 86400))))
(defun start-session (account pseudo &optional recovery)
  (let* ((token (random-hex 32)) (csrf-token (random-hex 32)))
    (query "INSERT INTO sessions(token_hash,compte,csrf,expires_at) VALUES($1,$2::uuid,$3,now()+interval '24 hours')" (digest token) account csrf-token)
    (set-session-cookie token)
    (response 200 (obj "id" account "pseudonyme" pseudo "csrf" csrf-token "authRecovery" (or recovery 'yason:null)))))
(defun etag (revision)
  (setf (hunchentoot:header-out "ETag") (format nil "\"~d\"" revision)))
(defun expected-revision ()
  (let ((value (hunchentoot:header-in* "If-Match")))
    (unless (and value (cl-ppcre:scan "^\"[0-9]+\"$" value)) (reject 428 "Révision If-Match requise."))
    (parse-integer (string-trim "\"" value))))

(defun api (path method)
  (when (member method '(:post :put :delete)) (check-origin))
  (cond
    ((and (string= path "/api/health") (eq method :get))
     (response 200 (obj "status" "ok" "prototype" t)))
    ((and (string= path "/api/register") (eq method :post))
     (throttle "register")
     (let* ((data (read-body)) (pseudo (field data "pseudonyme")) (password (field data "password"))
            (recovery (field data "authRecovery")) (payload (validate-payload (field data "payload"))))
       (validate-pseudo pseudo) (validate-password password)
       (unless (and (base64-p recovery 44) (= (length recovery) 44)) (reject 400 "Code de récupération de compte invalide."))
       (when (one "SELECT id FROM comptes WHERE pseudonyme=$1" (string-downcase pseudo))
         (reject 409 "Cet identifiant n’est pas disponible."))
       (let ((id (uuid)) (hash (hash-password password)))
         (postmodern:with-transaction ()
           (query "INSERT INTO comptes(id,pseudonyme,password_hash,auth_recovery_hash) VALUES($1::uuid,$2,$3,$4)" id (string-downcase pseudo) hash (digest recovery))
           (query "INSERT INTO coffres(compte,payload) VALUES($1::uuid,$2::jsonb)" id (json payload)))
         (start-session id (string-downcase pseudo)))))
    ((and (string= path "/api/login") (eq method :post))
     (throttle "login")
     (let* ((data (read-body)) (pseudo (field data "pseudonyme")) (password (field data "password")))
       (validate-pseudo pseudo) (validate-password password)
       (throttle "pseudo-login" (string-downcase pseudo))
       (let ((account (one "SELECT id::text,password_hash FROM comptes WHERE pseudonyme=$1" (string-downcase pseudo))))
         ;; Même coût pour un identifiant inconnu, sans exposer l'existence du compte.
         (unless (if account (verify-password password (second account))
                     (progn (password-key password "00000000000000000000000000000000") nil))
           (reject 401 "Identifiant ou mot de passe incorrect."))
         (start-session (first account) (string-downcase pseudo)))))
    ((and (string= path "/api/reset-auth") (eq method :post))
     (throttle "reset")
     (let* ((data (read-body)) (pseudo (field data "pseudonyme")) (password (field data "password")) (code (field data "code")))
       (validate-pseudo pseudo) (validate-password password)
       (unless (and (base64-p code 44) (= (length code) 44)) (reject 400 "Code de compte invalide."))
       (let ((account (one "SELECT id::text,auth_recovery_hash FROM comptes WHERE pseudonyme=$1" (string-downcase pseudo))))
         (unless (and account (equal-secret (second account) (digest code))) (reject 401 "Récupération de compte impossible avec ce code."))
         (let ((new-code (random-hex 32)))
           ;; Le nouveau code hex est à forte entropie ; le contrat autorise aussi
           ;; 64 caractères hex pour la rotation après récupération.
           (setf new-code (field data "newCode"))
           (unless (and (base64-p new-code 44) (= (length new-code) 44)) (reject 400 "Nouveau code de compte invalide."))
           (postmodern:with-transaction ()
             (query "UPDATE comptes SET password_hash=$1,auth_recovery_hash=$2 WHERE id=$3::uuid" (hash-password password) (digest new-code) (first account))
             (query "DELETE FROM sessions WHERE compte=$1::uuid" (first account)))
           (start-session (first account) (string-downcase pseudo) new-code)))))
    (t
     (let* ((session (authenticated)) (account (first session)))
       (when (member method '(:post :put :delete)) (csrf session))
       (cond
         ((and (string= path "/api/me") (eq method :get))
          (response 200 (obj "id" account "pseudonyme" (first (one "SELECT pseudonyme FROM comptes WHERE id=$1::uuid" account)) "csrf" (second session))))
         ((and (string= path "/api/logout") (eq method :post))
          (query "DELETE FROM sessions WHERE token_hash=$1" (digest (hunchentoot:cookie-in "carnet-session")))
          (set-session-cookie "" t) (response 200 (obj "ok" t)))
         ((string= path "/api/state")
          (cond
            ((eq method :get)
             (let ((row (one "SELECT revision,payload::text FROM coffres WHERE compte=$1::uuid" account)))
               (etag (first row))
               (response 200 (obj "revision" (first row) "payload" (yason:parse (second row))))))
            ((eq method :put)
             (let* ((expected (expected-revision)) (payload (validate-payload (read-body))) (row nil))
               (postmodern:with-transaction ()
                 (query "SELECT id FROM comptes WHERE id=$1::uuid FOR UPDATE" account)
                 (let ((old (one "SELECT octet_length(payload::text),payload->'keyring'->>'vault' FROM coffres WHERE compte=$1::uuid" account)))
                   (unless (equal (second old) (field (field payload "keyring") "vault"))
                     (reject 400 "Utilisez la création explicite d’un nouveau coffre."))
                   (check-quota account (+ 128 (length (json payload))) (first old)))
                 (setf row (one "UPDATE coffres SET payload=$1::jsonb,revision=revision+1,updated_at=now() WHERE compte=$2::uuid AND revision=$3 RETURNING revision" (json payload) account expected)))
               (unless row (reject 409 "Une autre version existe. Votre copie locale est conservée."))
               (etag (first row)) (response 200 (obj "revision" (first row)))))
            (t (reject 405 "Méthode non autorisée."))))
         ((string= path "/api/objects")
          (if (eq method :get)
              (response 200 (coerce (mapcar (lambda (row) (yason:parse (first row)))
                                           (query "SELECT payload::text FROM objets WHERE compte=$1::uuid ORDER BY id" account)) 'vector))
              (reject 405 "Méthode non autorisée.")))
         ((and (uiop:string-prefix-p "/api/objects/" path) (uuid-p (subseq path 13)))
          (let ((id (subseq path 13)))
            (cond
              ((eq method :get)
               (let ((row (one "SELECT payload::text FROM objets WHERE compte=$1::uuid AND id=$2::uuid" account id)))
                 (unless row (reject 404 "Objet absent.")) (response 200 (yason:parse (first row)))))
              ((eq method :put)
               (let* ((data (read-body)) (vault (field (field (yason:parse (second (one "SELECT revision,payload::text FROM coffres WHERE compte=$1::uuid" account))) "keyring") "vault")))
                 (validate-envelope data vault id)
                 (postmodern:with-transaction ()
                   ;; Verrou par compte : deux uploads ne dépassent pas le quota.
                   (query "SELECT id FROM comptes WHERE id=$1::uuid FOR UPDATE" account)
                   (let ((existing (one "SELECT octet_length(payload::text) FROM objets WHERE compte=$1::uuid AND id=$2::uuid" account id)))
                     (check-quota account (+ 128 (length (json data))) (if existing (first existing) 0))
                     (when (and (not existing) (>= (first (one "SELECT count(*) FROM objets WHERE compte=$1::uuid" account)) 20))
                       (reject 413 "Vingt photos maximum.")))
                   (query "INSERT INTO objets(compte,id,payload) VALUES($1::uuid,$2::uuid,$3::jsonb) ON CONFLICT(compte,id) DO UPDATE SET payload=excluded.payload" account id (json data)))
                 (response 200 (obj "ok" t))))
              ((eq method :delete)
               (query "DELETE FROM objets WHERE compte=$1::uuid AND id=$2::uuid" account id)
               (response 200 (obj "ok" t)))
              (t (reject 405 "Méthode non autorisée.")))))
         ((and (string= path "/api/new-vault") (eq method :post))
          (let ((expected (expected-revision)) (payload (validate-payload (read-body))))
            (postmodern:with-transaction ()
              (query "SELECT id FROM comptes WHERE id=$1::uuid FOR UPDATE" account)
              (check-quota account (+ 128 (length (json payload))))
              (let ((old (one "SELECT revision,payload::text FROM coffres WHERE compte=$1::uuid FOR UPDATE" account)))
                (unless (= expected (first old)) (reject 409 "Une autre version existe. L’ancien coffre est conservé."))
                (query "INSERT INTO archives(id,compte,payload,images) VALUES($1::uuid,$2::uuid,$3::jsonb,(SELECT coalesce(jsonb_agg(payload),'[]'::jsonb) FROM objets WHERE compte=$2::uuid))" (uuid) account (second old))
                (query "DELETE FROM objets WHERE compte=$1::uuid" account)
                (let ((row (one "UPDATE coffres SET payload=$1::jsonb,revision=revision+1,updated_at=now() WHERE compte=$2::uuid RETURNING revision" (json payload) account)))
                  (response 200 (obj "revision" (first row))))))))
         ((string= path "/api/archives")
          (cond
            ((eq method :get)
             (response 200 (coerce (mapcar (lambda (row) (obj "payload" (yason:parse (first row)) "images" (yason:parse (second row))))
                                          (query "SELECT payload::text,images::text FROM archives WHERE compte=$1::uuid ORDER BY created_at" account)) 'vector)))
            ((eq method :delete)
             (query "DELETE FROM archives WHERE compte=$1::uuid" account)
             (response 200 (obj "ok" t)))
            (t (reject 405 "Méthode non autorisée."))))
         ((and (string= path "/api/account") (eq method :delete))
          (let* ((data (read-body)) (password (field data "password"))
                 (row (one "SELECT password_hash FROM comptes WHERE id=$1::uuid" account)))
            (validate-password password)
            (unless (verify-password password (first row)) (reject 401 "Mot de passe incorrect."))
            (record-deletion account)
            (postmodern:with-transaction ()
              (query "INSERT INTO suppressions(compte) VALUES($1::uuid) ON CONFLICT DO NOTHING" account)
              (query "DELETE FROM comptes WHERE id=$1::uuid" account))
            (set-session-cookie "" t)
            (response 200 (obj "ok" t))))
         (t (reject 404 "Route absente.")))))))

(defun route ()
  (catch 'reply
    (dolist (header *headers*) (setf (hunchentoot:header-out (car header)) (cdr header)))
    (when *secure-cookie* (setf (hunchentoot:header-out "Strict-Transport-Security") "max-age=31536000"))
    (handler-case
        (let ((path (hunchentoot:script-name*)) (method (hunchentoot:request-method*)))
          (if (uiop:string-prefix-p "/api/" path)
              (with-db (api path method))
              (if (and (eq method :get)
                       (member path '("/" "/index.html" "/elm.js" "/bridge.js" "/worker.js" "/carnet.css" "/catalogue.json" "/favicon.svg") :test #'string=))
                  (hunchentoot:handle-static-file (merge-pathnames (if (string= path "/") "index.html" (subseq path 1)) *dist*))
                  (reject 404 "Page absente."))))
      (postmodern:database-error () (response 503 (obj "error" "Le service est momentanément indisponible. Votre copie locale reste conservée.")))
      (error () (response 400 (obj "error" "Requête refusée. Vérifiez les données envoyées."))))))

(defun migrate ()
  (with-db
    (postmodern:with-transaction ()
      (dolist (statement (uiop:split-string (uiop:read-file-string "backend/migrations/001.sql") :separator ";"))
        (unless (every (lambda (c) (find c '(#\Space #\Newline #\Return #\Tab))) statement) (query statement)))
      (replay-deletions)
      (query "DELETE FROM sessions WHERE expires_at<now() OR last_seen<now()-interval '2 hours'")
      (let ((days (parse-integer (env "CARNET_RETENTION_DAYS" "90"))))
        (unless (<= 1 days 3650) (error "Durée de conservation invalide"))
        (dolist (row (query "SELECT id::text FROM comptes WHERE last_seen<now()-($1::integer * interval '1 day')" days))
          (record-deletion (first row)))
        (query "INSERT INTO suppressions(compte) SELECT id FROM comptes WHERE last_seen<now()-($1::integer * interval '1 day') ON CONFLICT DO NOTHING" days)
        (query "DELETE FROM comptes WHERE id IN (SELECT compte FROM suppressions)")))))

(unless (string= (env "CARNET_LIBRARY_ONLY" "false") "true")
  (migrate)
  (setf hunchentoot:*dispatch-table* (list (lambda (request) (declare (ignore request)) #'route)))
  (hunchentoot:start (make-instance 'hunchentoot:easy-acceptor :port 3000 :address "0.0.0.0"
                                    :access-log-destination nil :message-log-destination nil
                                    :read-timeout 15 :write-timeout 15))
  (format t "Mon carnet · Common Lisp · port 3000 · contenu fictif uniquement~%")
  (loop (sleep 60)
        (handler-case (migrate) (error () (format t "Entretien différé : vérifier disponibilité base et journal.~%")))))
