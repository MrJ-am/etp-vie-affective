    "@lydell/elm": "0.19.1-14",
    "@playwright/test": "1.55.1",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "elm-format": "0.8.8",
    "esbuild": "0.25.10",
    "jsqr": "1.4.0",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "LGPL-3.0-or-later"
}
